{
  "message-composer": {
    "border-style": {
      "$description": "Style of the composer border (solid; dashed is set by the application, not animated).",
      "$value": "solid",
      "$type": "other"
    },
    "border-width": {
      "$value": "{sys.border.width.thin}",
      "$type": "dimension"
    },
    "border-color": {
      "$description": "Same default as the fields; the component falls back on --lc-input-border first.",
      "$value": "{sys.color.border-strong}",
      "$type": "color"
    },
    "background": {
      "$value": "{sys.color.surface-raised}",
      "$type": "color"
    },
    "shake-distance": {
      "$value": "{sys.space.1}",
      "$type": "dimension"
    },
    "shake-duration": {
      "$value": "{sys.duration.normal}",
      "$type": "duration"
    }
  }
}
