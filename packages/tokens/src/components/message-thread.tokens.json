{
  "message-thread": {
    "bubble-background-mine": {
      "$value": "{sys.color.primary-container}",
      "$type": "color"
    },
    "bubble-color-mine": {
      "$value": "{sys.color.on-primary-container}",
      "$type": "color"
    },
    "bubble-background-other": {
      "$value": "{sys.color.secondary-container}",
      "$type": "color"
    },
    "bubble-color-other": {
      "$value": "{sys.color.on-secondary-container}",
      "$type": "color"
    },
    "bubble-border-width": {
      "$value": "0",
      "$type": "dimension",
      "$description": "Set by the application on a message class (internal note: dashed)."
    },
    "bubble-border-style": {
      "$value": "solid",
      "$type": "other"
    },
    "bubble-border-color": {
      "$value": "transparent",
      "$type": "color"
    },
    "bubble-radius": {
      "$value": "calc({sys.radius.lg} * 1.5)",
      "$type": "dimension"
    },
    "bubble-radius-tight": {
      "$value": "{sys.radius.sm}",
      "$type": "dimension",
      "$description": "Author-side corners between two bubbles of a group."
    },
    "bubble-padding-block": {
      "$value": "{sys.space.2}",
      "$type": "dimension"
    },
    "bubble-padding-inline": {
      "$value": "{sys.space.3}",
      "$type": "dimension"
    },
    "bubble-gap": {
      "$value": "{sys.space.1}",
      "$type": "dimension"
    },
    "bubble-max-width": {
      "$value": "26rem",
      "$type": "dimension"
    },
    "bubble-max-share": {
      "$value": "0.8",
      "$type": "number"
    },
    "group-gap": {
      "$value": "{sys.space.4}",
      "$type": "dimension"
    },
    "thread-padding": {
      "$value": "{sys.space.4}",
      "$type": "dimension"
    },
    "avatar-size": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "thumb-width": {
      "$value": "6rem",
      "$type": "dimension"
    },
    "thumb-height": {
      "$value": "4.5rem",
      "$type": "dimension"
    },
    "day-background": {
      "$value": "{sys.color.surface-sunken}",
      "$type": "color"
    },
    "day-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    },
    "meta-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    },
    "system-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    },
    "enter-easing": {
      "$value": "linear(0, 0.009, 0.035 2.1%, 0.141 4.4%, 0.723 12.9%, 0.938 16.7%, 1.017 19.4%, 1.067, 1.099 24.3%, 1.108 26%, 1.104, 1.088 30.6%, 1.03 37.7%, 1.008 41.4%, 0.993 45.8%, 0.988 50%, 0.993 59.8%, 1.002 75.4%, 1)",
      "$type": "other",
      "$description": "iOS-style spring (linear(), Baseline 2023); component token, no sys spring (exception to decision 27 of the motion spec)."
    },
    "enter-duration": {
      "$value": "550ms",
      "$type": "duration",
      "$description": "Tuned to the spring above."
    },
    "enter-scale": {
      "$value": "0.6",
      "$type": "number"
    },
    "enter-fade-duration": {
      "$value": "{sys.duration.normal}",
      "$type": "duration"
    },
    "enter-stagger": {
      "$value": "{sys.motion.stagger}",
      "$type": "duration"
    }
  }
}
