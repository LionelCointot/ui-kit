{
  "message-thread": {
    "bubble-background-mine": {
      "$value": "{sys.color.primary-container}",
      "$type": "color"
    },
    "bubble-color-mine": {
      "$value": "{sys.color.on-primary-container}",
      "$type": "color"
    },
    "bubble-background-other": {
      "$value": "{sys.color.secondary-container}",
      "$type": "color"
    },
    "bubble-color-other": {
      "$value": "{sys.color.on-secondary-container}",
      "$type": "color"
    },
    "bubble-border-width": {
      "$value": "0",
      "$type": "dimension",
      "$description": "Set by the application on a message class (internal note: dashed)."
    },
    "bubble-border-style": {
      "$value": "solid",
      "$type": "other"
    },
    "bubble-border-color": {
      "$value": "transparent",
      "$type": "color"
    },
    "bubble-radius": {
      "$value": "calc({sys.radius.lg} * 1.5)",
      "$type": "dimension"
    },
    "bubble-radius-tight": {
      "$value": "{sys.radius.sm}",
      "$type": "dimension",
      "$description": "Author-side corners between two bubbles of a group."
    },
    "bubble-padding-block": {
      "$value": "{sys.space.2}",
      "$type": "dimension"
    },
    "bubble-padding-inline": {
      "$value": "{sys.space.3}",
      "$type": "dimension"
    },
    "bubble-gap": {
      "$value": "{sys.space.1}",
      "$type": "dimension"
    },
    "bubble-max-width": {
      "$value": "26rem",
      "$type": "dimension"
    },
    "bubble-max-share": {
      "$value": "0.8",
      "$type": "number"
    },
    "group-gap": {
      "$value": "{sys.space.4}",
      "$type": "dimension"
    },
    "thread-padding": {
      "$value": "{sys.space.4}",
      "$type": "dimension"
    },
    "avatar-size": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "thumb-width": {
      "$value": "6rem",
      "$type": "dimension"
    },
    "thumb-height": {
      "$value": "4.5rem",
      "$type": "dimension"
    },
    "day-background": {
      "$value": "{sys.color.surface-sunken}",
      "$type": "color"
    },
    "day-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    },
    "meta-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    },
    "system-rule-color": {
      "$value": "{sys.color.border}",
      "$type": "color"
    },
    "system-gap": {
      "$value": "{sys.space.1}",
      "$type": "dimension"
    },
    "system-detail-color": {
      "$value": "{sys.color.on-surface-muted}",
      "$type": "color"
    }
  }
}
