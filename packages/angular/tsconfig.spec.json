/* Configuration TypeScript des tests (Vitest) : les chemins pointent vers les sources des points d'entrée. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"],
    "paths": {
      "@lionelcointot/ui-angular": ["./src/public-api.ts"],
      "@lionelcointot/ui-angular/*": ["./*/src/public-api.ts"]
    }
  },
  "include": ["**/*.d.ts", "**/*.spec.ts"]
}
