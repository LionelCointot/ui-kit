{
  "name": "ui-kit-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run tokens:build && npm run catalogue:build && npm run build:lib",
    "catalogue:build": "node tools/generate-catalogue.mjs",
    "catalogue:check": "node tools/generate-catalogue.mjs --check",
    "catalogue:test": "node --test tools/generate-catalogue.test.mjs tools/generate-catalogue.acceptance.test.mjs",
    "snippets:test": "node --test .storybook/code-snippet.test.mjs",
    "snippets:check": "node tools/qa/storybook-snippets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens:build": "npm run build --workspace @lionelcointot/ui-tokens",
    "build:lib": "ng build ui-angular",
    "storybook": "ng run ui-angular:storybook",
    "storybook:public": "ng run ui-angular:storybook",
    "build-storybook": "ng run ui-angular:build-storybook",
    "build-storybook:public": "ng run ui-angular:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6",
    "jsdom": "^30.0.0",
    "lucide-static": "^1.70.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "storybook": "10.6",
    "style-dictionary": "^5.8.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@storybook/angular-vite": "10.6.6",
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular/animations": "22.2.5",
    "@angular-devkit/architect": "0.2202.5",
    "@storybook/addon-vitest": "10.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "1.65.0"
  },
  "description": "Espace de travail du ui-kit (bibliothèque de composants Angular et design tokens)",
  "workspaces": [
    "packages/tokens"
  ],
  "license": "AGPL-3.0-only"
}
