{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "page-transitions": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "qa",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "../../../packages/tokens/dist/css/lc-tokens.css",
              "../../../packages/tokens/dist/css/theme-default.css",
              "../../../packages/tokens/dist/css/base.css",
              "../../../packages/angular/styles/ui-angular.css",
              "src/styles.css"
            ],
            "optimization": false,
            "sourceMap": false
          }
        }
      }
    }
  }
}
